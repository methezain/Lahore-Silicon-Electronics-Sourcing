---
import '../styles/global.css';
import TopUtilityBanner from '../components/TopUtilityBanner.astro';
import GlobalNavbar from '../components/GlobalNavbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.tsx';

interface Props {
	title?: string;
}

const { title = "Lahore Silicon - Electronic Component Sourcing" } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-brand-50 text-brand-900 scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class="min-h-screen flex flex-col font-sans antialiased">
		<TopUtilityBanner />
		<GlobalNavbar />
		<main class="flex-grow w-full pt-32 pb-16 px-4 max-w-5xl mx-auto">
			<slot />
		</main>
		<Footer />
		<CartDrawer client:load />
	</body>
</html>
