---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import CartSheet from '../components/CartSheet.tsx';
import { loadCatalog } from '../lib/catalog';
import { partTransitionCss } from '../lib/part-image';
import { shippingWindows } from '../lib/shipping';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  robots?: string;
}

const {
  title = "Lahore Silicon — Electronic Component Sourcing from Hall Road",
  description = `On-demand sourcing of ICs, microcontrollers, sensors, and passive components from Hall Road, Lahore. ${shippingWindows}`,
  ogImage = "/og-image.png",
  canonical = Astro.url.href,
  robots = "index, follow",
} = Astro.props;

const catalog = await loadCatalog();
const transitionCss = partTransitionCss(catalog.map((part) => part.part_number));
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Lahore Silicon" />
    <meta property="og:locale" content="en_PK" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <Font cssVariable="--font-mona" preload />
    <Font cssVariable="--font-geist-mono" />
    <style is:global set:html={transitionCss}></style>

    <!-- Page-level head slot -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <IconSprite />
    <SiteHeader parts={catalog} />
    <main id="main" class="flex-grow w-full">
      <slot />
    </main>
    <Footer />
    <CartSheet client:load catalog={catalog} />
  </body>
</html>
