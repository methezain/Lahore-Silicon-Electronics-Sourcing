---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import PartPicture from "../../components/PartPicture.astro";
import ProductPurchase from "../../components/ProductPurchase.tsx";
import { partThumbSrc } from "../../lib/catalog";
import { formatPkr, unitPrice } from "../../lib/money";
import { productPhoto } from "../../lib/part-image";
import { deliveryCost, returnRule, shippingWindows } from "../../lib/shipping";

export const prerender = true;

export async function getStaticPaths() {
  const components = await getCollection("components");
  return components.map((component) => ({
    params: { part_number: component.data.part_number.toLowerCase() },
    props: { component },
  }));
}

const { component } = Astro.props;
const { data } = component;
const unit = unitPrice({ price: data.price, breaks: data.breaks }, 1);
const thumb = data.image ? await partThumbSrc(data.image) : undefined;
const stockLabel = data.stock_qty > 0 ? `${data.stock_qty} in stock` : data.restock_on ? `Back on ${data.restock_on}` : "Out of stock";

const schemaLD: Record<string, unknown> = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: data.name,
  description: data.description,
  sku: data.part_number,
  mpn: data.mpn,
  brand: { "@type": "Brand", name: data.manufacturer },
  offers: {
    "@type": "Offer",
    url: `https://lahoresilicon.com/product/${data.part_number.toLowerCase()}`,
    priceCurrency: data.currency,
    price: String(unit),
    availability: data.stock_qty > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    seller: { "@type": "Organization", name: "Lahore Silicon" },
  },
};
if (data.image) {
  const photo = await getImage({
    src: data.image,
    width: productPhoto.width,
    height: productPhoto.height,
    format: "webp",
  });
  schemaLD.image = [new URL(photo.src, Astro.site ?? Astro.url).href];
}
---

<Layout title={`${data.part_number} — ${data.name}`} description={data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaLD)} />
  </Fragment>

  <article class="product-screen" data-pagefind-body>
    <p class="sr-only">{data.mpn}</p>
    <div>
      <div class="image-well">
        {data.image ? (
          <PartPicture
            src={data.image}
            partNumber={data.part_number}
            alt={`${data.part_number}, ${data.package_type}`}
            width={productPhoto.width}
            height={productPhoto.height}
            sizes={productPhoto.sizes}
            widths={[...productPhoto.widths]}
            priority
            frameClass="image-frame"
          />
        ) : (
          <p class="mono">{data.package_type}</p>
        )}
      </div>
      {data.image_note && <p class="image-note caption">{data.image_note}</p>}
    </div>

    <div class="product-facts">
      <h1 class="title">{data.name}</h1>
      <p class="part-number">{data.part_number}</p>
      <hr class="copper-rule" />
      <p class="price money">{formatPkr(unit)}</p>
      <p>{stockLabel}</p>
      <p>{shippingWindows}</p>
      <p>{deliveryCost}</p>
      <ProductPurchase
        client:load
        part_number={data.part_number}
        name={data.name}
        image={thumb}
        min_qty={data.min_qty}
        qty_multiple={data.qty_multiple}
        stock_qty={data.stock_qty}
      />
      {data.datasheet && (
        <p><a href={data.datasheet}>Datasheet</a></p>
      )}
      <p>{data.in_the_bag}</p>
      {data.limits && <p>{data.limits}</p>}
      <p><a href="/shipping-and-payments#defects">{returnRule}</a></p>
    </div>
  </article>

  <section class="spec-block" aria-labelledby="specs-heading">
    <h2 id="specs-heading" class="heading">Specifications</h2>
    <dl class="spec-table">
      {data.specs.map((spec, index) => (
        <div class={index % 2 === 1 ? "spec-row is-sunken" : "spec-row"}>
          <dt>{spec.label}</dt>
          <dd>{spec.unit ? `${spec.value} ${spec.unit}` : spec.value}</dd>
        </div>
      ))}
    </dl>
    <p class="body">{data.description}</p>
  </section>
</Layout>
