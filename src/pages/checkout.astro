---
import Layout from '../layouts/Layout.astro';
import { catalogScriptJson, loadCatalog } from '../lib/catalog';
import { formatPkr } from '../lib/money';
import { paymentMethods, shopPhone, whatsappHref } from '../lib/shop';
import { deliveryCost, shippingWindows } from '../lib/shipping';

const methods = paymentMethods();
const catalogJson = catalogScriptJson(await loadCatalog());
const phone = shopPhone();
const wa = whatsappHref('Hi, I need help with my order');
const description = methods.length > 0
  ? `Complete your sourcing order. Advance payment via ${methods.map((method) => method.label).join(', ')}.`
  : 'Complete your sourcing order. Advance payment is required before parts are procured.';
---

<Layout title="Checkout — Lahore Silicon" description={description}>
  <div class="page" id="checkout-container">
    <p class="label">Guest checkout</p>
    <h1 class="display">Checkout</h1>
    <p class="lede">
      {methods.length > 0
        ? 'Pay the total shown here, then paste the transaction id. Nothing new is added on this page.'
        : 'Paste the payment reference. Account details are not published on this page, and the total does not change here.'}
    </p>

    <div class="checkout-grid">
      <form id="checkout-form" class="panel stack">
        <h2 class="heading">Where it ships</h2>
        <div class="field">
          <label for="field-name">Name, required</label>
          <input type="text" name="name" id="field-name" aria-required="true" autocomplete="name" />
          <p id="field-name-error" class="error hidden" role="alert"></p>
        </div>
        <div class="field">
          <label for="field-phone">Phone, required</label>
          <div class="phone-field">
            <span>+92</span>
            <input type="tel" name="phone" id="field-phone" inputmode="numeric" autocomplete="tel" aria-required="true" placeholder="3XX XXXXXXX" aria-describedby="field-phone-help field-phone-error" />
          </div>
          <p id="field-phone-help" class="caption">We use this if the courier cannot find the address.</p>
          <p id="field-phone-error" class="error hidden" role="alert"></p>
        </div>
        <div class="field">
          <label for="field-destination">City or area, required</label>
          <input type="text" name="destination" id="field-destination" aria-required="true" autocomplete="address-level2" aria-describedby="field-destination-error" />
          <p id="field-destination-error" class="error hidden" role="alert"></p>
        </div>
        <div class="field">
          <label for="field-address">Address, required</label>
          <textarea name="address" id="field-address" aria-required="true" rows="3"></textarea>
          <p id="field-address-error" class="error hidden" role="alert"></p>
        </div>
        <details>
          <summary>Add an apartment, floor, or landmark</summary>
          <div class="field mt-12">
            <label for="field-address-2">Address line 2, optional</label>
            <input type="text" name="address_line_2" id="field-address-2" autocomplete="address-line2" />
          </div>
        </details>
        <div class="field">
          <label for="field-payment-ref">Payment reference, required</label>
          <input type="text" name="payment_ref" id="field-payment-ref" aria-required="true" class="mono" />
          <p id="field-payment-error" class="error hidden" role="alert"></p>
          <p class="caption">{methods.length > 0 ? "Pay the total on this page, then paste the transaction id." : "Advance payment is required before the part is bought. Account details are not published on this page."}</p>
        </div>
        <button type="submit" id="submit-btn" class="btn-ink">Place order</button>
        <p id="error-msg" class="error hidden" role="alert"></p>
      </form>

      <aside class="stack summary">
        <div class="panel stack">
          <h2 class="heading">Order</h2>
          <div id="summary-items" class="stack"></div>
          <div class="summary-row"><span>Merchandise</span><span id="summary-merchandise" class="money mono">{formatPkr(0)}</span></div>
          <div>
            <p>Shipping</p>
            <p class="caption">{deliveryCost}</p>
            <p class="caption">{shippingWindows}</p>
          </div>
          <div class="summary-row"><span>Total</span><span id="summary-total" class="price money">{formatPkr(0)}</span></div>
        </div>
        {methods.length > 0 && (
          <div class="panel ink-panel stack">
            <h2 class="heading">Pay this total</h2>
            <p class="caption">Transfer the amount above, then paste the transaction id.</p>
            {methods.length > 1 && (
              <div class="actions">
                {methods.map((method, i) => (
                  <button class:list={["payment-tab btn-quiet", { "is-selected": i === 0 }]} data-tab={method.id} type="button">
                    {method.label}
                  </button>
                ))}
              </div>
            )}
            {methods.map((method, i) => (
              <div id={method.id} class:list={["payment-panel stack", { hidden: i > 0 }]}>
                {method.lines.map((row) => (
                  <div class="pay-row">
                    <span class="caption">{row.label}</span>
                    <span class="mono">{row.value}</span>
                    <button class="copy-btn btn-quiet" type="button" data-copy={row.value}>Copy</button>
                  </div>
                ))}
              </div>
            ))}
          </div>
        )}
        {wa && phone && (
          <a class="caption" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp {phone.display}</a>
        )}
      </aside>
    </div>
  </div>
  <script type="application/json" id="catalog-prices" is:inline set:html={catalogJson}></script>
</Layout>

<script>
  import { cartStore } from '../store/cartStore';
  import { formatPkr, priceCart, type CatalogPrice } from '../lib/money';
  import { orderNotSaved } from '../lib/order';
  import { normalizePkMobile, phoneRule } from '../lib/phone';

  // ===== Order summary =====
  const itemsContainer = document.getElementById('summary-items');
  const totalEl = document.getElementById('summary-total');
  const merchandiseEl = document.getElementById('summary-merchandise');
  const nameInput = document.getElementById('field-name') as HTMLInputElement | null;
  const nameError = document.getElementById('field-name-error');
  const addressInput = document.getElementById('field-address') as HTMLTextAreaElement | null;
  const addressError = document.getElementById('field-address-error');
  const paymentInput = document.getElementById('field-payment-ref') as HTMLInputElement | null;
  const paymentError = document.getElementById('field-payment-error');
  const phoneInput = document.getElementById('field-phone') as HTMLInputElement | null;
  const phoneError = document.getElementById('field-phone-error');
  const destinationInput = document.getElementById('field-destination') as HTMLInputElement | null;
  const destinationError = document.getElementById('field-destination-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg');

  function readCatalog(): CatalogPrice[] {
    try {
      const node = document.getElementById('catalog-prices');
      if (!node?.textContent) return [];
      const parsed = JSON.parse(node.textContent) as unknown;
      return Array.isArray(parsed) ? parsed as CatalogPrice[] : [];
    } catch {
      return [];
    }
  }

  const catalog = readCatalog();

  function setTotals(amount: number) {
    const label = formatPkr(amount);
    if (totalEl) totalEl.textContent = label;
    if (merchandiseEl) merchandiseEl.textContent = label;
  }

  function showFieldError(input: HTMLElement | null, errorEl: HTMLElement | null, message: string | null) {
    if (!errorEl) return;
    if (!message) {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
      input?.removeAttribute('aria-invalid');
      return;
    }
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    input?.setAttribute('aria-invalid', 'true');
  }

  function phoneMessage(): string | null {
    const value = phoneInput?.value ?? '';
    if (!value.trim()) return phoneRule;
    return normalizePkMobile(value) ? null : phoneRule;
  }

  function nameMessage(): string | null {
    return (nameInput?.value.trim().length ?? 0) >= 2 ? null : "Name must be at least 2 characters";
  }
  function addressMessage(): string | null {
    return (addressInput?.value.trim().length ?? 0) >= 10 ? null : "Please provide a complete address";
  }
  function paymentMessage(): string | null {
    return (paymentInput?.value.trim().length ?? 0) >= 5 ? null : "Payment Reference is too short";
  }
  function destinationMessage(): string | null {
    const value = destinationInput?.value.trim() ?? '';
    return value.length >= 2 ? null : 'Enter the city or area.';
  }

  function setSubmitEnabled(enabled: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = !enabled;
  }

  const renderSummary = () => {
    const items = Object.values(cartStore.get());
    if (!itemsContainer || !totalEl) return;
    itemsContainer.replaceChildren();

    if (items.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'caption';
      empty.textContent = 'Your cart is empty.';
      itemsContainer.appendChild(empty);
      setTotals(0);
      setSubmitEnabled(false);
      return;
    }

    const priced = priceCart(catalog, items);
    for (const line of priced.lines) {
      const row = document.createElement('div');
      row.className = 'summary-row';

      const copy = document.createElement('div');
      copy.className = 'summary-copy';

      const title = document.createElement('p');
      title.className = 'mono';
      title.textContent = `${line.quantity}× ${line.part_number}`;

      const name = document.createElement('p');
      name.className = 'caption';
      name.textContent = line.name;

      const amount = document.createElement('span');
      amount.className = 'money';
      amount.textContent = formatPkr(line.line_total);

      copy.appendChild(title);
      copy.appendChild(name);
      row.appendChild(copy);
      row.appendChild(amount);
      itemsContainer.appendChild(row);
    }

    for (const partNumber of priced.missing) {
      const note = document.createElement('p');
      note.className = 'error';
      note.textContent = `The shop does not sell ${partNumber}.`;
      itemsContainer.appendChild(note);
    }
    for (const partNumber of priced.invalid) {
      const note = document.createElement('p');
      note.className = 'error';
      note.textContent = `${partNumber}: quantity must be a positive integer.`;
      itemsContainer.appendChild(note);
    }

    setTotals(priced.total);
    setSubmitEnabled(priced.lines.length > 0 && priced.missing.length === 0 && priced.invalid.length === 0);
  };

  cartStore.subscribe(renderSummary);

  phoneInput?.addEventListener('blur', () => {
    if (!phoneInput.value.trim()) {
      showFieldError(phoneInput, phoneError, null);
      return;
    }
    showFieldError(phoneInput, phoneError, phoneMessage());
  });
  destinationInput?.addEventListener('blur', () => {
    if (!destinationInput.value.trim()) {
      showFieldError(destinationInput, destinationError, null);
      return;
    }
    showFieldError(destinationInput, destinationError, destinationMessage());
  });
  nameInput?.addEventListener('blur', () => {
    if (!nameInput.value.trim()) { showFieldError(nameInput, nameError, null); return; }
    showFieldError(nameInput, nameError, nameMessage());
  });
  addressInput?.addEventListener('blur', () => {
    if (!addressInput.value.trim()) { showFieldError(addressInput, addressError, null); return; }
    showFieldError(addressInput, addressError, addressMessage());
  });
  paymentInput?.addEventListener('blur', () => {
    if (!paymentInput.value.trim()) { showFieldError(paymentInput, paymentError, null); return; }
    showFieldError(paymentInput, paymentError, paymentMessage());
  });

  document.querySelectorAll('.payment-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      if (!(tab instanceof HTMLElement)) return;
      const targetId = tab.dataset.tab;
      document.querySelectorAll('.payment-tab').forEach((other) => {
        other.classList.toggle('is-selected', other === tab);
      });
      document.querySelectorAll('.payment-panel').forEach((panel) => {
        panel.classList.add('hidden');
      });
      if (targetId) document.getElementById(targetId)?.classList.remove('hidden');
    });
  });

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!(btn instanceof HTMLElement)) return;
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '✓ Copied';
        btn.classList.add('is-copied');
        window.setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('is-copied');
        }, 2000);
      } catch {
        /* clipboard can be denied */
      }
    });
  });

  // ===== Form submission =====
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.innerText = 'Processing...';
      if (errorMsg) errorMsg.classList.add('hidden');

      const formData = new FormData(form);
      const priced = priceCart(catalog, Object.values(cartStore.get()));
      if (priced.missing.length > 0 || priced.invalid.length > 0 || priced.lines.length === 0) {
        const message = priced.missing.length > 0
          ? `The shop does not sell ${priced.missing[0]}.`
          : priced.invalid.length > 0
            ? 'Quantity must be a positive integer.'
            : 'Cart cannot be empty.';
        if (errorMsg) { errorMsg.textContent = message; errorMsg.classList.remove('hidden'); }
        submitBtn.innerText = 'Place order';
        renderSummary();
        return;
      }
      const problems = [
        [nameInput, nameError, nameMessage()],
        [phoneInput, phoneError, phoneMessage()],
        [destinationInput, destinationError, destinationMessage()],
        [addressInput, addressError, addressMessage()],
        [paymentInput, paymentError, paymentMessage()],
      ] as const;
      let firstInvalid: HTMLElement | null = null;
      for (const [input, errorEl, message] of problems) {
        showFieldError(input, errorEl, message);
        if (message && !firstInvalid && input) firstInvalid = input;
      }
      if (firstInvalid) {
        submitBtn.innerText = 'Place order';
        renderSummary();
        firstInvalid.focus();
        return;
      }
      const line2 = String(formData.get('address_line_2') ?? '').trim();
      const payload = {
        name: formData.get('name'),
        phone: normalizePkMobile(String(formData.get('phone') ?? '')),
        address: formData.get('address'),
        destination: String(formData.get('destination') ?? '').trim(),
        address_line_2: line2 || undefined,
        payment_ref: formData.get('payment_ref'),
        items: priced.lines.map((line) => ({
          part_number: line.part_number,
          name: line.name,
          price: line.price,
          quantity: line.quantity,
        })),
        total: priced.total,
      };

      try {
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json() as { id?: string; error?: string };
        if (res.ok) {
          cartStore.set({});
          window.location.href = `/order-success/${data.id}`;
        } else {
          throw new Error(data.error || orderNotSaved);
        }
      } catch (err: any) {
        if (errorMsg) { errorMsg.innerText = err.message; errorMsg.classList.remove('hidden'); }
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerText = 'Place order'; }
      }
    });
  }
</script>
