---
/**
 * Shipping and payment. docs/pages.md#shipping-and-payment-shipping-and-payments.
 * Sentences come from src/lib/shipping.ts and src/lib/shop.ts.
 */
import "./info.css";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { inspectedBeforeDispatch } from "../lib/desk";
import {
  clockRows,
  defectNotice,
  deliveryCost,
  lahoreDelivery,
  nationwideDelivery,
  noCashOnDelivery,
  remoteDelivery,
  returnRule,
} from "../lib/shipping";
import { copyAction, copiedAction, pageTitle, paymentMethods, paymentSentOnWhatsApp, whatsappHref } from "../lib/shop";

const methods = paymentMethods();
const wa = whatsappHref();
const description = methods.length > 0
  ? `${noCashOnDelivery} ${returnRule}`
  : `${paymentSentOnWhatsApp} ${returnRule}`;
---

<Layout title={pageTitle("Shipping and payment")} description={description}>
  <article class="info-page">
    <p class="eyebrow">Policy</p>
    <h1 class="title">Shipping and payment</h1>
    <p class="lede">The same rules as the product page, the cart, and checkout.</p>
    <nav class="jumps" aria-label="On this page">
      <a href="#dispatch">Dispatch</a>
      <a href="#delivery">Delivery</a>
      <a href="#payment">Payment</a>
      <a href="#returns">Returns</a>
    </nav>

    <div class="info-stack">
      <section class="sheet" id="dispatch" aria-labelledby="dispatch-heading">
        <h2 id="dispatch-heading" class="heading">Dispatch</h2>
        <dl class="facts">
          {clockRows.map((row) => (
            <div>
              <dt>
                <span class="fact-label">{row.label}</span>
                <span class="fact-detail">{row.detail}</span>
              </dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
        <p>{inspectedBeforeDispatch}</p>
      </section>

      <section class="sheet" id="delivery" aria-labelledby="delivery-heading">
        <h2 id="delivery-heading" class="heading">Delivery</h2>
        <p>{lahoreDelivery}</p>
        <p>{nationwideDelivery}</p>
        <p>{remoteDelivery}</p>
        <p>{deliveryCost}</p>
      </section>

      <section class="sheet" id="payment" aria-labelledby="payment-heading">
        <h2 id="payment-heading" class="heading">Payment</h2>
        <p>{noCashOnDelivery}</p>
        {methods.length > 0 ? (
          methods.map((method) => (
            <div class="pay-method">
              <h3 class="heading">{method.label}</h3>
              {method.lines.map((row) => (
                <div class="pay-line">
                  <span class="pay-label">{row.label}</span>
                  <span class="pay-value">{row.value}</span>
                  <button
                    class="copy-btn"
                    type="button"
                    data-copy={row.value}
                    data-label={row.label}
                    data-idle={copyAction}
                    data-done={copiedAction}
                    aria-label={`${copyAction} ${row.label}`}
                  >{copyAction}</button>
                </div>
              ))}
            </div>
          ))
        ) : (
          <p>
            {wa ? (
              <a href={wa} target="_blank" rel="noopener noreferrer">{paymentSentOnWhatsApp}</a>
            ) : (
              paymentSentOnWhatsApp
            )}
          </p>
        )}
        <p id="copy-status" class="sr-only" aria-live="polite"></p>
      </section>

      <section class="sheet" id="defects" aria-labelledby="returns">
        <h2 class="heading" id="returns">Returns</h2>
        <p>{returnRule}</p>
        <p>{defectNotice}</p>
        {wa ? (
          <div class="actions">
            <Button href={wa} target="_blank" variant="primary">Message on WhatsApp</Button>
          </div>
        ) : (
          <div class="actions">
            <Button href="/contact" variant="primary">Contact</Button>
          </div>
        )}
      </section>
    </div>
  </article>
</Layout>

<script>
  const copyStatus = document.getElementById("copy-status");
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    if (!(btn instanceof HTMLButtonElement)) return;
    let timer = 0;
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const idle = btn.dataset.idle ?? "Copy";
      const done = btn.dataset.done ?? "Copied";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      btn.textContent = done;
      btn.setAttribute("aria-label", done);
      if (copyStatus) copyStatus.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = idle;
        btn.setAttribute("aria-label", `${idle} ${btn.dataset.label ?? ""}`.trim());
        if (copyStatus) copyStatus.textContent = "";
      }, 2000);
    });
  });
</script>
