---
import Layout from '../../layouts/Layout.astro';

export const prerender = false; // Dynamic page

const { id } = Astro.params;

// In a real production scenario, we could fetch the order details from D1 here
// const env = (Astro.locals as any).runtime?.env;
// const order = await env.DB.prepare("SELECT * FROM Orders WHERE id = ?").bind(id).first();

const whatsappNumber = "923001234567"; // Business WhatsApp
const message = encodeURIComponent(`Hello Lahore Silicon! I just placed order #${id}. Here is my payment receipt screenshot.`);
const waLink = `https://wa.me/${whatsappNumber}?text=${message}`;
---

<Layout title={`Order Successful - ${id}`}>
  <div class="max-w-2xl mx-auto text-center pt-12 pb-24 px-4">
    <div class="w-24 h-24 bg-accent-emerald text-brand-50 rounded-full flex items-center justify-center mx-auto mb-8 shadow-lg shadow-emerald-500/20">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    
    <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tight text-brand-900 mb-4">Order Received!</h1>
    <p class="text-xl text-brand-900/70 mb-8 font-medium">Your Order ID is <span class="text-brand-900 font-bold bg-brand-200 px-3 py-1 rounded-lg ml-1">#{id}</span></p>
    
    <div class="bg-white border border-brand-200 rounded-3xl p-8 mb-8 text-left shadow-sm">
      <h2 class="font-bold text-lg uppercase tracking-tight mb-4 border-b border-brand-200 pb-2">Next Step: Verification</h2>
      <p class="text-brand-900/80 mb-6 leading-relaxed">
        To expedite your dispatch, please send a screenshot of your payment receipt to our WhatsApp support team. We will immediately verify the transaction and hand over your package to Leopards Courier.
      </p>
      
      <a 
        href={waLink} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 w-full bg-[#25D366] text-white py-4 rounded-xl font-bold uppercase tracking-widest hover:bg-[#1DA851] transition-colors shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Send Receipt on WhatsApp
      </a>
    </div>
    
    <a href="/" class="text-brand-900 font-bold uppercase tracking-tight hover:text-brand-500 transition-colors border-b-2 border-brand-900 hover:border-brand-500 pb-1">
      Return to Catalog
    </a>
  </div>
</Layout>
