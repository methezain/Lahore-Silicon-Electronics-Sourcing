---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { formatPkr } from '../../lib/money';
import { unknownOrder } from '../../lib/order';
import { whatsappHref } from '../../lib/shop';

export const prerender = false;

const requestedId = Astro.params.id ?? "";

type OrderRow = {
  id: string;
  total_price: number;
};

let order: OrderRow | null = null;
let lookupFailed = false;

if (!env?.DB) {
  lookupFailed = true;
  Astro.response.status = 500;
} else {
  try {
    const row = await env.DB.prepare(
      "SELECT id, total_price FROM Orders WHERE id = ?",
    )
      .bind(requestedId)
      .first<OrderRow>();
    if (!row) {
      Astro.response.status = 404;
    } else {
      order = row;
    }
  } catch {
    console.error("Order lookup failed.");
    lookupFailed = true;
    Astro.response.status = 500;
  }
}

const waLink = order
  ? whatsappHref(`Order ${order.id}. Here is my payment receipt screenshot.`)
  : undefined;

const title = order
  ? `Order ${order.id} — Lahore Silicon`
  : lookupFailed
    ? "Order lookup failed — Lahore Silicon"
    : `${unknownOrder} — Lahore Silicon`;
---

<Layout title={title}>
  <div class="page page-narrow">
    {order ? (
      <div class="panel stack">
        <p class="label">Saved</p>
        <h1 class="display">Order placed</h1>
        <p>This id is the one stored with the order.</p>
        <p class="part-number">{order.id}</p>
        <hr class="copper-rule" />
        <p class="price money">Total {formatPkr(order.total_price)}</p>
        {waLink && (
          <a class="btn-ink" href={waLink} target="_blank" rel="noopener noreferrer">Send the receipt on WhatsApp</a>
        )}
        <a href="/">Back to the catalog</a>
      </div>
    ) : (
      <div class="panel stack">
        <h1 class="title">{lookupFailed ? "The order record could not be loaded." : unknownOrder}</h1>
        <a class="btn-ink" href="/">Back to the catalog</a>
        <a href="/contact">Contact the desk</a>
      </div>
    )}
  </div>
</Layout>
