---
import type { CollectionEntry } from 'astro:content';
interface Props {
  components: CollectionEntry<'components'>[];
}
const { components } = Astro.props;
---
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
  {components.map((component: any) => (
    <a href={`/product/${component.data.part_number.toLowerCase()}`} class="block group">
      <div class="bg-brand-50 border border-brand-200 rounded-2xl overflow-hidden group-hover:border-brand-500 group-hover:shadow-md transition-all flex flex-col h-full relative">
        <div class="aspect-square bg-white border-b border-brand-200 flex items-center justify-center p-4">
          {component.data.image ? (
            <img src={component.data.image} alt={component.data.name} class="w-full h-full object-contain mix-blend-multiply" loading="lazy" decoding="async" />
          ) : (
            <div class="text-3xl font-black text-brand-900/10">{component.data.part_number}</div>
          )}
        </div>
        <p class="text-xs text-brand-900/70 mb-5">{component.data.voltage} • {component.data.package_type}</p>
        <div class="flex items-center justify-between mt-auto">
          <span class="font-mono font-bold text-lg">Rs. {component.data.price}</span>
          <button class="bg-brand-900 text-brand-50 rounded-full w-9 h-9 flex items-center justify-center hover:bg-accent-amber hover:text-brand-900 transition-colors border border-brand-900">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
        </div>
      </div>
    </a>
  ))}
</div>
