---
/**
 * Full spec list under the key figures.
 * docs/design-system.md section 9 (Key figures): dl, label keys, values on the right.
 */
interface Spec {
  label: string;
  value: string;
  unit?: string;
}

interface Props {
  specs: Spec[];
}

const { specs } = Astro.props;

function valueText(spec: Spec): string {
  return spec.unit ? `${spec.value}\u00A0${spec.unit}` : spec.value;
}
---

<div class="spec-panel">
  <dl>
    {specs.map((spec) => (
      <div class="row">
        <dt>{spec.label}</dt>
        <dd>{valueText(spec)}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .spec-panel {
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  dl {
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    padding: var(--space-12) var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .row:first-child {
    border-top: 0;
  }

  dt {
    margin: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: normal;
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    font-variant-numeric: tabular-nums;
    line-height: var(--text-small--line-height);
    text-align: right;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
</style>
