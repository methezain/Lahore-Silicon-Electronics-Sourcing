---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { isRemote, mediaUrl } from "../lib/media";
import { partTransitionClass } from "../lib/part-image";

interface Props {
  src: ImageMetadata;
  partNumber: string;
  alt: string;
  width: number;
  height: number;
  sizes: string;
  widths?: number[];
  /** Product gallery only. Sets fetchpriority and skips lazy loading. */
  priority?: boolean;
  /** Off when the same part is drawn twice on one page. */
  transition?: boolean;
  class?: string;
  frameClass?: string;
  /** Cut-outs use contain so the whole part stays inside the stage. */
  fit?: "cover" | "contain";
}

const {
  src,
  partNumber,
  alt,
  width,
  height,
  sizes,
  widths,
  priority = false,
  transition = true,
  class: className,
  frameClass,
  fit = "cover",
} = Astro.props;

const remote = isRemote(src) ? src : null;
const classes = ["remote-photo", className, transition && partTransitionClass(partNumber)].filter(Boolean).join(" ");
const loading = priority
  ? { priority: true as const }
  : { loading: "lazy" as const, decoding: "async" as const };
---

{remote ? (
  <picture class={frameClass}>
    <img
      src={mediaUrl(remote.media, 640)}
      srcset={`${mediaUrl(remote.media, 640)} 640w, ${mediaUrl(remote.media, 1024)} 1024w`}
      sizes={sizes}
      alt={alt}
      width={width}
      height={height}
      class={classes}
      loading={priority ? undefined : "lazy"}
      decoding={priority ? undefined : "async"}
      fetchpriority={priority ? "high" : undefined}
    />
  </picture>
) : (
<Picture
  src={src}
  alt={alt}
  width={width}
  height={height}
  sizes={sizes}
  widths={widths}
  layout="constrained"
  fit={fit}
  formats={["avif", "webp"]}
  class:list={[className, transition && partTransitionClass(partNumber)]}
  pictureAttributes={frameClass ? { class: frameClass } : undefined}
  {...loading}
/>
)}
