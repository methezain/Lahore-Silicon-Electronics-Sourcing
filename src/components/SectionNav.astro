---
/**
 * On-page section links. The current section follows scroll.
 * docs/premium-roadmap.md R4.
 */
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="section-nav" data-section-nav aria-label="On this page">
  {items.map((item, index) => (
    <a href={item.href} aria-current={index === 0 ? "true" : undefined}>{item.label}</a>
  ))}
</nav>

<script>
  const navNode = document.querySelector("[data-section-nav]");
  if (navNode instanceof HTMLElement && navNode.dataset.bound !== "true") {
    const nav: HTMLElement = navNode;
    nav.dataset.bound = "true";
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const sections = links.flatMap((link) => {
      const id = link.getAttribute("href")?.slice(1);
      const section = id ? document.getElementById(id) : null;
      return section ? [{ link, section }] : [];
    });

    let frame = 0;

    function update() {
      frame = 0;
      if (sections.length === 0) return;
      const line = nav.getBoundingClientRect().bottom + 32;
      let current = sections[0];
      for (const entry of sections) {
        if (entry.section.getBoundingClientRect().top <= line) current = entry;
      }
      for (const entry of sections) {
        if (entry === current) entry.link.setAttribute("aria-current", "true");
        else entry.link.removeAttribute("aria-current");
      }
    }

    function onScroll() {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    }

    update();
    document.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>

<style>
  .section-nav {
    position: sticky;
    top: var(--header-clearance);
    z-index: 20;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-8) 0;
    overflow-x: auto;
    background: var(--color-canvas);
    box-shadow: inset 0 -1px 0 var(--color-line);
  }

  a {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-small--line-height);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast, var(--dur-1)) var(--ease-out), color var(--dur-fast, var(--dur-1)) var(--ease-out);
  }

  a[aria-current="true"] {
    background: var(--color-navy);
    box-shadow: none;
    color: var(--color-on-navy);
  }

  a:focus-visible {
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
