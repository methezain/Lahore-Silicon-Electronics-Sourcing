---
import Logo from './Logo.astro';
import { CATEGORIES } from '../lib/categories';
import { deskHours } from '../lib/desk';
import { returnRule, sameDayDispatch } from '../lib/shipping';
import { shopPhone, whatsappHref } from '../lib/shop';

const phone = shopPhone();
const wa = whatsappHref();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const category = Astro.url.searchParams.get('category');

const catalogLinks = [
  { label: 'All parts', href: '/#catalog', current: path === '/' && !category },
  ...CATEGORIES.map((label) => ({
    label,
    href: `/?category=${encodeURIComponent(label)}#catalog`,
    current: path === '/' && category === label,
  })),
];

const counterLinks = [
  { label: 'Shipping and payment', href: '/shipping-and-payments', current: path === '/shipping-and-payments' },
  { label: 'About', href: '/about', current: path === '/about' },
  { label: 'Contact', href: '/contact', current: path === '/contact' },
  ...(wa && phone ? [{ label: `WhatsApp ${phone.display}`, href: wa, current: false }] : []),
];
---

<footer class="site-footer">
  <div class="site-footer-grid">
    <div class="site-footer-brand">
      <Logo href="/" surface="navy" />
      <p class="site-footer-blurb">Parts from Hall Road, Lahore. {deskHours}</p>
    </div>
    <div>
      <h2 class="label">Catalog</h2>
      <ul>
        {catalogLinks.map((link) => (
          <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="label">Counter</h2>
      <ul>
        {counterLinks.map((link) => (
          <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="label">Dispatch</h2>
      <ul>
        <li>{sameDayDispatch}</li>
        <li>{returnRule}</li>
      </ul>
    </div>
  </div>
</footer>
