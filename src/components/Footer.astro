---
import { CATEGORIES } from '../lib/categories';
import { deskHours } from '../lib/desk';
import { cutoffValue, sameDayDispatch } from '../lib/shipping';
import { shopPhone, whatsappHref } from '../lib/shop';

const phone = shopPhone();
const wa = whatsappHref();
const catalogLinks = [
  { label: 'All', href: '/#catalog' },
  ...CATEGORIES.map((label) => ({ label, href: `/?category=${encodeURIComponent(label)}#catalog` })),
];
---

<footer class="site-footer">
  <div class="site-footer-grid">
    <div>
      <p class="wordmark">Lahore Silicon</p>
      <p class="caption">Parts from Hall Road, Lahore.</p>
      <p class="caption">{deskHours}</p>
    </div>
    <div>
      <h2 class="label">Catalog</h2>
      <ul>
        {catalogLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="label">Desk</h2>
      <ul>
        <li><a href="/shipping-and-payments">Shipping and payment</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        {wa && phone && <li><a href={wa}>WhatsApp {phone.display}</a></li>}
      </ul>
    </div>
    <div>
      <h2 class="label">Dispatch</h2>
      <p class="caption">Dispatch cutoff: {cutoffValue}</p>
      <p class="caption">{sameDayDispatch}</p>
    </div>
  </div>
  <p class="caption site-footer-note">&copy; {new Date().getFullYear()} Lahore Silicon. Hall Road, Lahore.</p>
</footer>
