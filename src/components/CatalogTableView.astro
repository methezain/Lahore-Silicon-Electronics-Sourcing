---
import type { CollectionEntry } from 'astro:content';
import AddToCartButton from './AddToCartButton.tsx';
import { formatPkr, unitPrice } from '../lib/money';

interface Props {
  components: CollectionEntry<'components'>[];
}
const { components } = Astro.props;
---

<div
  class="rounded-2xl overflow-hidden overflow-x-auto"
  style="background:#ffffff; border:1px solid #EDF2F6; box-shadow:0 4px 20px -4px rgba(12,29,50,0.06);"
>
  <table class="w-full text-left text-sm whitespace-nowrap">
    <thead style="background:#0C1D32; color:#ffffff;">
      <tr>
        <th class="px-5 py-4 font-semibold text-xs tracking-wider" style="color:rgba(255,255,255,0.7);">PART #</th>
        <th class="px-5 py-4 font-semibold text-xs tracking-wider" style="color:rgba(255,255,255,0.7);">COMPONENT</th>
        <th class="px-5 py-4 font-semibold text-xs tracking-wider" style="color:rgba(255,255,255,0.7);">CATEGORY</th>
        <th class="px-5 py-4 font-semibold text-xs tracking-wider" style="color:rgba(255,255,255,0.7);">PACKAGE</th>
        <th class="px-5 py-4 font-semibold text-xs tracking-wider" style="color:rgba(255,255,255,0.7);">PRICE (PKR)</th>
        <th class="px-5 py-4 font-semibold text-xs tracking-wider text-right" style="color:rgba(255,255,255,0.7);">ACTION</th>
      </tr>
    </thead>
    <tbody>
      {components.map((component, i) => (
        <tr
          data-category={component.data.category}
          style={`background:${i % 2 === 0 ? '#ffffff' : '#FAFBFC'}; border-bottom:1px solid #EDF2F6;`}
          onmouseover="this.style.background='#F8FAFC'"
          onmouseout={`this.style.background='${i % 2 === 0 ? '#ffffff' : '#FAFBFC'}'`}
          class="transition-colors"
        >
          <!-- Part number -->
          <td class="px-5 py-3.5">
            <a
              href={`/product/${component.data.part_number.toLowerCase()}`}
              class="font-bold text-sm transition-colors"
              style="color:#0C1D32; font-family:'JetBrains Mono',monospace; text-decoration:none;"
              onmouseover="this.style.color='#007AAD'"
              onmouseout="this.style.color='#0C1D32'"
            >
              {component.data.part_number}
            </a>
          </td>

          <!-- Name -->
          <td class="px-5 py-3.5">
            <a
              href={`/product/${component.data.part_number.toLowerCase()}`}
              class="text-sm font-medium transition-colors block max-w-xs truncate"
              style="color:#475569; text-decoration:none;"
              onmouseover="this.style.color='#0C1D32'"
              onmouseout="this.style.color='#475569'"
            >
              {component.data.name}
            </a>
            <!-- Stock indicator -->
            <span
              class="inline-flex items-center gap-1 text-[10px] font-semibold mt-0.5"
              style={component.data.stock_qty > 0 ? "color:#059669;" : "color:#E11D48;"}
            >
              {component.data.stock_qty} in stock
            </span>
          </td>

          <!-- Category pill -->
          <td class="px-5 py-3.5">
            <span
              class="px-2.5 py-1 rounded-full text-[11px] font-semibold"
              style="background:#EBF6FD; color:#007AAD;"
            >{component.data.category}</span>
          </td>

          <!-- Package -->
          <td class="px-5 py-3.5 text-xs font-medium" style="color:#475569;">
            {component.data.package_type}
          </td>

          <!-- Price -->
          <td class="px-5 py-3.5">
            <span class="money font-bold text-sm" style="color:#0C1D32; font-family:'JetBrains Mono',monospace;">
              {formatPkr(unitPrice({ price: component.data.price }, 1))}
            </span>
          </td>

          <!-- Action -->
          <td class="px-5 py-3.5 text-right">
            {component.data.stock_qty > 0 && (
              <AddToCartButton
                client:visible
                part_number={component.data.part_number}
                name={component.data.name}
                image={component.data.image}
                stock_qty={component.data.stock_qty}
                compact={true}
              />
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
