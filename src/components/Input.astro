---
/**
 * Labeled field. docs/design-system.md section 9 (Inputs).
 * The label is always visible. The placeholder is an example.
 */
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: "text" | "search" | "tel" | "email" | "password";
  value?: string;
  placeholder?: string;
  help?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  shape?: "field" | "pill";
  size?: "default" | "large";
  autocomplete?: string;
  inputmode?: "text" | "numeric" | "tel" | "email" | "search";
}

const {
  id,
  label,
  name,
  type = "text",
  value,
  placeholder,
  help,
  error,
  disabled = false,
  required = false,
  shape = "field",
  size = "default",
  autocomplete,
  inputmode,
} = Astro.props;

const helpId = help ? `${id}-help` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helpId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class="field">
  <label for={id}>{label}</label>
  <input
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    autocomplete={autocomplete}
    inputmode={inputmode}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    class:list={[shape === "pill" && "pill", size === "large" && "large"]}
  />
  {help && <p id={helpId} class="help">{help}</p>}
  {error && <p id={errorId} class="error" role="alert">{error}</p>}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  .field label {
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-small--line-height);
  }

  .field input {
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0 var(--space-16);
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    box-shadow: inset 0 0 0 1px var(--color-control-line);
    appearance: none;
  }

  .field input.pill {
    border-radius: var(--radius-pill);
  }

  .field input.large {
    min-height: 52px;
    padding-inline: var(--space-20);
  }

  .field input::placeholder {
    color: var(--color-ink-muted);
    opacity: 1;
  }

  .field input:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-action);
  }

  .field input[aria-invalid="true"] {
    box-shadow: inset 0 0 0 1px var(--color-out);
  }

  .field input[aria-invalid="true"]:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-out);
  }

  .field input:disabled {
    background: var(--color-sunken);
    color: var(--color-ink-muted);
    cursor: not-allowed;
  }

  .field .help,
  .field .error {
    margin: 0;
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    text-wrap: pretty;
  }

  .field .help {
    color: var(--color-ink-muted);
  }

  .field .error {
    color: var(--color-out);
  }
</style>
