---
---
<header class="fixed top-12 left-0 right-0 z-50 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="bg-brand-50 border border-brand-700 rounded-full px-6 py-3 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <a href="/" class="text-xl font-bold tracking-tight text-brand-900 uppercase">
          Lahore Silicon
        </a>
      </div>
      
      <div class="flex-1 w-full max-w-2xl md:mx-4">
        <div class="relative w-full">
          <input 
            type="text" 
            placeholder="Search part number (e.g., NE555)..." 
            class="w-full bg-white border border-brand-700 rounded-full py-2.5 px-6 text-sm focus:outline-none focus:ring-1 focus:ring-brand-900 font-mono text-brand-900"
          />
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <button class="bg-accent-emerald text-brand-900 rounded-full px-6 py-2.5 text-sm font-bold border border-brand-900 uppercase tracking-tight hover:bg-emerald-400 transition-colors">
          Cart (0)
        </button>
      </div>
    </div>
  </div>
</header>
