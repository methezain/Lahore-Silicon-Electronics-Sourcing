---
import CartButton from './CartButton.tsx';
---

<!--
  DESIGN REFERENCE: Cardiology app navbar
  - Entire nav is ONE large rounded rectangle container (not full-width bar)
  - Brand mark sits on the far LEFT at full height
  - Nav pills curve visually from brand level down to the right
  - The container has a strong border-radius, creating a "frame" feel
  - Floats above page with a soft shadow — not glued to edges
-->

<!-- Notice bar stays full-width at top (32px) -->
<!-- Navbar floats as a contained card below it -->
<div
  id="navbar-wrapper"
  class="fixed left-0 right-0 z-40 px-4 sm:px-6 transition-all duration-300"
  style="top: 32px; padding-top: 10px;"
>
  <div class="max-w-7xl mx-auto">

    <!--
      THE MAIN NAV CONTAINER
      One large rounded-2xl shape that holds everything.
      Brand on left, nav pills in center/right, actions at far right.
      The visual "arc" from the reference is achieved by:
      - The brand being vertically centered in a taller left section
      - Nav pills being in a slightly more compact row
      - A unified background container making it feel like one piece
    -->
    <div
      id="global-navbar"
      class="flex items-center gap-3 px-3 py-2 transition-all duration-300"
      style="
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(217,226,233,0.8);
        border-radius: 20px;
        box-shadow: 0 4px 24px -4px rgba(12,29,50,0.10), 0 1px 4px rgba(12,29,50,0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      "
    >

      <!-- ======= BRAND MARK — Left anchor ======= -->
      <a
        href="/"
        class="flex items-center gap-2.5 flex-shrink-0 mr-1"
        style="text-decoration:none;"
      >
        <!-- Circuit icon -->
        <div
          class="flex items-center justify-center flex-shrink-0"
          style="width:36px; height:36px; background:#0C1D32; border-radius:12px;"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="2.5" fill="#007AAD"/>
            <path d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M6.34 6.34l2.12 2.12M15.54 15.54l2.12 2.12M6.34 17.66l2.12-2.12M15.54 8.46l2.12-2.12" stroke="#007AAD" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Brand text -->
        <div class="leading-none">
          <div class="font-black tracking-tight" style="font-size:0.9375rem; color:#0C1D32; letter-spacing:-0.03em;">
            LAHORE<span style="color:#007AAD;">·</span>SILICON
          </div>
          <div class="font-medium hidden sm:block" style="font-size:0.625rem; color:#475569; margin-top:1px; letter-spacing:0.04em; text-transform:uppercase;">
            Hall Road Counter
          </div>
        </div>
      </a>

      <!-- Subtle vertical divider after brand -->
      <div class="flex-shrink-0 hidden md:block" style="width:1px; height:28px; background:#D9E2E9; margin:0 4px;"></div>

      <!-- ======= NAV PILLS — Desktop (the "arc" row) ======= -->
      <!--
        These are the capsule pills from the reference.
        They sit in a tight row, one active in accent color.
        The visual "curve" from reference is the unified container + pill arrangement.
      -->
      <nav
        class="hidden lg:flex items-center flex-shrink-0"
        style="gap:2px;"
        id="desktop-nav"
      >
        {[
          { label: 'Catalog',         href: '/',              active: true  },
          { label: 'How It Works',    href: '/#how-it-works', active: false },
          { label: 'Custom Sourcing', href: '/contact#quote', active: false },
          { label: 'About',           href: '/about',         active: false },
          { label: 'Contact',         href: '/contact',       active: false },
        ].map((link, i) => (
          <a
            href={link.href}
            class="nav-pill whitespace-nowrap transition-all duration-150"
            data-index={i}
            style={`
              display: inline-flex;
              align-items: center;
              padding: 0.4rem 0.875rem;
              border-radius: 9999px;
              font-size: 0.8125rem;
              font-weight: 600;
              text-decoration: none;
              background: ${i === 0 ? '#007AAD' : 'transparent'};
              color: ${i === 0 ? '#ffffff' : '#475569'};
            `}
            onmouseover={`if(this.dataset.active!=='true'){this.style.background='#F1F5F9';this.style.color='#0C1D32';}`}
            onmouseout={`if(this.dataset.active!=='true'){this.style.background='transparent';this.style.color='#475569';}`}
            data-active={i === 0 ? 'true' : 'false'}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- ======= SEARCH BAR — Grows to fill center space ======= -->
      <div class="flex-1 min-w-0 hidden md:block" style="max-width:380px; margin:0 8px;">
        <div class="relative">
          <div
            class="absolute top-1/2 -translate-y-1/2 pointer-events-none"
            style="left:12px; color:#475569;"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
          </div>
          <input
            id="search-input"
            type="text"
            placeholder="Search IC, module, part number..."
            autocomplete="off"
            style="
              width:100%;
              padding: 0.45rem 2.5rem 0.45rem 2rem;
              background: #F1F5F9;
              border: 1.5px solid transparent;
              border-radius: 9999px;
              font-size: 0.8rem;
              color: #0C1D32;
              outline: none;
              font-family: inherit;
              transition: all 0.15s;
            "
            onfocus="this.style.background='#ffffff'; this.style.borderColor='#007AAD'; this.style.boxShadow='0 0 0 3px rgba(0,122,173,0.1)';"
            onblur="this.style.background='#F1F5F9'; this.style.borderColor='transparent'; this.style.boxShadow='none';"
          />
          <div class="absolute top-1/2 -translate-y-1/2" style="right:10px;">
            <kbd style="font-size:9px; font-family:'JetBrains Mono',monospace; font-weight:700; padding:2px 5px; border-radius:4px; background:#D9E2E9; color:#475569; border:1px solid #bbc8d2;">/</kbd>
          </div>
          <!-- Search results dropdown -->
          <div
            id="search-results"
            class="hidden"
            style="
              position:absolute; top:calc(100% + 8px); left:0; right:0;
              background:#ffffff; border:1px solid #D9E2E9;
              border-radius:16px;
              box-shadow:0 16px 40px -8px rgba(12,29,50,0.16);
              max-height:20rem; overflow-y:auto; z-index:60;
            "
          ></div>
        </div>
      </div>

      <!-- Spacer pushes actions to right -->
      <div class="flex-1 hidden lg:block"></div>

      <!-- ======= ACTION CLUSTER ======= -->
      <div class="flex items-center gap-2 flex-shrink-0">

        <!-- Track Order (desktop) -->
        <a
          href="/contact"
          class="hidden xl:flex items-center gap-1.5 whitespace-nowrap transition-all duration-150"
          style="padding:0.4rem 0.875rem; border-radius:9999px; font-size:0.8125rem; font-weight:600; color:#475569; text-decoration:none;"
          onmouseover="this.style.background='#F1F5F9'; this.style.color='#0C1D32';"
          onmouseout="this.style.background='transparent'; this.style.color='#475569';"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Track
        </a>

        <!-- Cart button -->
        <CartButton client:load />

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden flex items-center justify-center transition-all"
          style="width:36px; height:36px; border-radius:10px; border:none; background:transparent; cursor:pointer; color:#0C1D32;"
          aria-label="Open navigation menu"
          onmouseover="this.style.background='#F1F5F9'"
          onmouseout="this.style.background='transparent'"
        >
          <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="menu-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- ======= MOBILE EXPANDED MENU ======= -->
    <div
      id="mobile-menu"
      class="hidden mt-2"
      style="
        background: rgba(255,255,255,0.97);
        border: 1px solid rgba(217,226,233,0.8);
        border-radius: 20px;
        box-shadow: 0 8px 32px -4px rgba(12,29,50,0.14);
        overflow: hidden;
        backdrop-filter: blur(12px);
      "
    >
      <!-- Mobile search -->
      <div style="padding:12px 14px 8px;">
        <div class="relative">
          <div class="absolute top-1/2 -translate-y-1/2 pointer-events-none" style="left:12px; color:#475569;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
          </div>
          <input
            id="mobile-search-input"
            type="text"
            placeholder="Search components..."
            style="width:100%; padding:0.55rem 1rem 0.55rem 2.25rem; background:#F1F5F9; border:1.5px solid transparent; border-radius:12px; font-size:0.85rem; color:#0C1D32; outline:none;"
          />
        </div>
      </div>

      <!-- Mobile nav links as pills grid -->
      <nav style="display:flex; flex-wrap:wrap; gap:6px; padding:8px 14px 14px;">
        {[
          { label: 'Catalog',         href: '/'               },
          { label: 'How It Works',    href: '/#how-it-works'  },
          { label: 'Custom Sourcing', href: '/contact#quote'  },
          { label: 'About Us',        href: '/about'          },
          { label: 'Contact',         href: '/contact'        },
          { label: 'Track Order',     href: '/contact'        },
          { label: 'Shipping Policy', href: '/shipping-and-payments' },
        ].map(link => (
          <a
            href={link.href}
            style="display:inline-flex; align-items:center; padding:0.45rem 1rem; border-radius:9999px; font-size:0.8rem; font-weight:600; color:#475569; background:#F1F5F9; text-decoration:none; transition:all 0.15s;"
            onmouseover="this.style.background='#D9E2E9'; this.style.color='#0C1D32';"
            onmouseout="this.style.background='#F1F5F9'; this.style.color='#475569';"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</div>

<script is:inline>
  // ======= Search =======
  window.addEventListener('DOMContentLoaded', () => {
    let pagefind;
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    if (!input || !results) return;

    const runSearch = async (q) => {
      if (q.length < 2) { results.classList.add('hidden'); return; }
      if (!pagefind) {
        try { pagefind = await import('/pagefind/pagefind.js'); await pagefind.init(); }
        catch { results.classList.remove('hidden'); results.innerHTML = '<div style="padding:1rem;text-align:center;font-size:0.8rem;color:#475569;">Search unavailable in dev mode.</div>'; return; }
      }
      const search = await pagefind.search(q);
      results.innerHTML = '';
      results.classList.remove('hidden');
      if (search.results.length > 0) {
        for (const r of search.results.slice(0, 6)) {
          const d = await r.data();
          const a = document.createElement('a');
          a.href = d.url;
          a.style.cssText = 'display:block;padding:0.75rem 1rem;border-bottom:1px solid #EDF2F6;text-decoration:none;transition:background 0.1s;';
          a.onmouseover = () => a.style.background = '#F8FAFC';
          a.onmouseout = () => a.style.background = 'transparent';
          a.innerHTML = `<p style="font-weight:700;font-size:0.85rem;color:#0C1D32;font-family:'JetBrains Mono',monospace;">${d.meta.title}</p><p style="font-size:0.75rem;color:#475569;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${d.excerpt}</p>`;
          results.appendChild(a);
        }
      } else {
        results.innerHTML = `<div style="padding:1rem;text-align:center;font-size:0.82rem;color:#475569;">No results for "<strong style="color:#0C1D32;">${q}</strong>"</div>`;
      }
    };

    input.addEventListener('input', e => runSearch(e.target.value));
    document.addEventListener('click', e => {
      if (!input.contains(e.target) && !results.contains(e.target)) results.classList.add('hidden');
    });
    document.addEventListener('keydown', e => {
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault(); input.focus();
      }
    });
  });

  // ======= Mobile menu toggle =======
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', open);
      iconOpen?.classList.toggle('hidden', !open);
      iconClose?.classList.toggle('hidden', open);
    });
  }

  // ======= Highlight active nav link based on current path =======
  const currentPath = window.location.pathname;
  document.querySelectorAll('.nav-pill').forEach(pill => {
    const href = pill.getAttribute('href');
    const isActive = href === currentPath || (href !== '/' && currentPath.startsWith(href));
    if (isActive) {
      pill.style.background = '#007AAD';
      pill.style.color = '#ffffff';
      pill.dataset.active = 'true';
    } else {
      pill.style.background = 'transparent';
      pill.style.color = '#475569';
      pill.dataset.active = 'false';
    }
  });

  // ======= Scroll: slightly shrink navbar on scroll =======
  const wrapper = document.getElementById('navbar-wrapper');
  if (wrapper) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        wrapper.style.paddingTop = '6px';
      } else {
        wrapper.style.paddingTop = '10px';
      }
    }, { passive: true });
  }
</script>
