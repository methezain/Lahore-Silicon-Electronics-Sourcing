---
/**
 * Real stock counts for /home. docs/pages.md (Home) and docs/motion.md item 26.
 * Every number comes from the catalog record. No meter unless a shelf quantity exists.
 */
import { formatPkr } from "../lib/money";
import StockIndicator from "./StockIndicator.astro";

export interface StockRow {
  href: string;
  partNumber: string;
  stockQty: number;
  restockOn?: string;
  price: number;
}

interface Props {
  rows: readonly StockRow[];
  catalogHref: string;
}

const { rows, catalogHref } = Astro.props;
---

{rows.length > 0 && (
  <section class="strip home-reveal" id="stock" aria-labelledby="stock-title">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Stock</p>
          <h2 id="stock-title">Counted on the counter</h2>
        </div>
        <a class="catalog" href={catalogHref}>Browse the catalog</a>
      </div>
      <ul>
        {rows.map((row) => (
          <li>
            <a class="row" href={row.href}>
              <span class="pn">{row.partNumber}</span>
              <StockIndicator stockQty={row.stockQty} restockOn={row.restockOn} />
              <span class="amt">{formatPkr(row.price)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .strip {
    padding: var(--space-40) 0 var(--space-16);
  }

  .wrap {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-16);
    margin-bottom: var(--space-20);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: normal;
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }

  h2 {
    margin: var(--space-8) 0 0;
    color: var(--color-ink);
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-stretch: calc(var(--wdth-display) * 1%);
    font-variation-settings: "wdth" var(--wdth-display);
    text-wrap: balance;
  }

  .catalog {
    flex: none;
    color: var(--color-link);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-small--line-height);
    text-decoration: none;
  }

  .catalog:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "pn amt"
      "stock amt";
    align-items: center;
    gap: var(--space-4) var(--space-12);
    min-height: 44px;
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line);
    text-decoration: none;
    transition: box-shadow var(--dur-1) var(--ease-out);
  }

  .row:hover {
    box-shadow: inset 0 0 0 1px var(--color-control-line), var(--shadow-2);
  }

  .pn {
    grid-area: pn;
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-part);
    font-size: var(--text-small);
    font-weight: var(--font-weight-part);
    font-variation-settings: normal;
    letter-spacing: var(--tracking-part);
    line-height: var(--text-small--line-height);
  }

  .row :global(.stock) {
    grid-area: stock;
    min-width: 0;
  }

  .amt {
    grid-area: amt;
    font-size: var(--text-small);
    font-weight: var(--font-weight-num);
    font-variant-numeric: tabular-nums;
    font-variation-settings: "wdth" var(--wdth-num);
    letter-spacing: var(--tracking-num);
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .strip {
      padding: var(--space-64) 0 var(--space-24);
    }

    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row {
      transition: none;
    }
  }
</style>
