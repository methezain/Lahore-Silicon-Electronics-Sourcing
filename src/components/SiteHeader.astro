---
import CartButton from "./CartButton.tsx";
import SiteSearch from "./SiteSearch.tsx";
import type { CatalogPart } from "../lib/catalog";

interface Props {
  parts: Pick<CatalogPart, "part_number" | "mpn" | "name" | "category">[];
}

const { parts } = Astro.props;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <a class="wordmark" href="/">Lahore Silicon</a>
  <SiteSearch client:load parts={parts} />
  <CartButton client:load />
  <p id="cart-status" class="sr-only" aria-live="polite"></p>
</header>
