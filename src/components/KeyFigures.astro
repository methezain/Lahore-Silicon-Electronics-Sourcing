---
/**
 * Four decision figures. docs/design-system.md section 9 (Key figures).
 * The first tile is navy, figure in signal. Labels and values are passed in.
 */
interface Figure {
  label: string;
  value: string;
  unit?: string;
}

interface Props {
  figures: Figure[];
}

const { figures } = Astro.props;
---

<div class="figures">
  {figures.map((figure, index) => (
    <div class:list={["tile", index === 0 && "is-lead"]}>
      <p class="figure-label">{figure.label}</p>
      <p class:list={["value", !figure.unit && "is-text"]}>
        {figure.value}{figure.unit && <span class="unit">&nbsp;{figure.unit}</span>}
      </p>
    </div>
  ))}
</div>

<style>
  .figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }

  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-20);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  .tile.is-lead {
    background: var(--color-navy);
    color: var(--color-on-navy);
    box-shadow: none;
  }

  .figure-label {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: normal;
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .tile.is-lead .figure-label {
    color: var(--color-on-navy-muted);
  }

  .value {
    margin: var(--space-16) 0 0;
    font-size: var(--text-display);
    font-weight: var(--font-weight-num);
    font-variant-numeric: tabular-nums;
    font-variation-settings: "wdth" var(--wdth-num);
    letter-spacing: var(--tracking-num);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .tile.is-lead .value {
    color: var(--color-signal);
  }

  .value.is-text {
    font-size: var(--text-title);
    font-weight: var(--text-title--font-weight);
    font-variation-settings: "wdth" var(--wdth-title);
    letter-spacing: var(--text-title--letter-spacing);
    line-height: var(--text-title--line-height);
  }

  .unit {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: "wdth" var(--wdth-body);
    letter-spacing: 0;
  }

  .tile.is-lead .unit {
    color: var(--color-on-navy-muted);
  }

  @media (min-width: 900px) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
