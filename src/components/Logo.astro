---
interface Props {
  surface?: "light" | "navy";
  href?: string;
}

const { surface = "light", href } = Astro.props;
const classes = ["logo", surface === "navy" ? "logo-on-navy" : "logo-on-light"];
---

{
  href ? (
    <a class:list={classes} href={href}>
      <svg width="32" height="32" aria-hidden="true" focusable="false">
        <use href="#plug" />
      </svg>
      <span>Lahore Silicon</span>
    </a>
  ) : (
    <p class:list={classes}>
      <svg width="32" height="32" aria-hidden="true" focusable="false">
        <use href="#plug" />
      </svg>
      <span>Lahore Silicon</span>
    </p>
  )
}
