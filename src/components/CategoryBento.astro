---
/**
 * Shop-by-job bento. docs/design-system.md section 9 (Category bento).
 * Counts and the part line are computed. The page passes them in.
 */
import type { ImageMetadata } from "astro";
import { partNoun } from "../lib/home";
import PartPicture from "./PartPicture.astro";
import PhotoStage from "./PhotoStage.tsx";

export interface BentoTile {
  href: string;
  category: string;
  heading: string;
  count: number;
  featured?: boolean;
  partNumbers?: string[];
  image?: ImageMetadata;
  imagePart?: string;
}

interface Props {
  tiles: BentoTile[];
  total: number;
  allHref: string;
}

const { tiles, total, allHref } = Astro.props;
---

<section class="bento-section" aria-labelledby="bento-title">
  <div class="wrap">
    <div class="section-head">
      <div class="stack">
        <p class="eyebrow is-long">Shop by job</p>
        <h2 id="bento-title">What are you building?</h2>
      </div>
      <a class="all" href={allHref}>All {total} {partNoun(total)}</a>
    </div>
    <div class="bento">
      {tiles.map((tile) => (
        <a class:list={["tile", tile.featured && "big"]} href={tile.href}>
          <span class="arrow" aria-hidden="true">
            <svg width="16" height="16">
              <use href="#arrow" />
            </svg>
          </span>
          <span class="copy">
            <span class="eyebrow">{tile.category}</span>
            <span class="title">{tile.heading}</span>
            {tile.partNumbers && tile.partNumbers.length > 0 && (
              <span class="line">
                {tile.partNumbers.map((partNumber, index) => (
                  <>
                    {index > 0 && <span>{index === tile.partNumbers!.length - 1 ? " and " : ", "}</span>}
                    <span class="pn">{partNumber}</span>
                  </>
                ))}
              </span>
            )}
          </span>
          <span class="n">
            {tile.count}{" "}
            <span class:list={["unit", !tile.featured && "sr-only"]}>{partNoun(tile.count)}</span>
          </span>
          {tile.featured && tile.image && tile.imagePart && (
            <span class="shot">
              <PhotoStage cutout>
                <PartPicture
                  src={tile.image}
                  partNumber={tile.imagePart}
                  alt=""
                  width={480}
                  height={480}
                  sizes="(min-width: 900px) 280px, 42vw"
                  widths={[320, 480]}
                  transition={false}
                  fit="contain"
                  class="photo"
                  frameClass="frame"
                />
              </PhotoStage>
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .bento-section {
    padding: var(--space-56) 0;
  }

  .wrap {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-24);
    margin-bottom: var(--space-24);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    min-width: 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: normal;
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }

  .eyebrow.is-long {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-caption--line-height);
    letter-spacing: 0;
    text-transform: none;
  }

  h2 {
    margin: var(--space-8) 0 0;
    color: var(--color-ink);
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-stretch: calc(var(--wdth-display) * 1%);
    font-variation-settings: "wdth" var(--wdth-display);
    text-wrap: balance;
  }

  .all {
    flex: none;
    color: var(--color-link);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-small--line-height);
    text-decoration: none;
  }

  .all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-16);
    min-width: 0;
    min-height: var(--space-128);
    padding: var(--space-20) var(--space-48) var(--space-20) var(--space-20);
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line);
    text-decoration: none;
    transition: box-shadow var(--dur-2) var(--ease-out);
  }

  .tile:hover {
    box-shadow: inset 0 0 0 1px var(--color-control-line), var(--shadow-2);
  }

  .big {
    grid-column: span 2;
    min-height: calc(var(--space-80) + var(--space-80) + var(--space-80));
    background: var(--color-navy);
    color: var(--color-on-navy);
    box-shadow: none;
  }

  .big:hover {
    box-shadow: var(--shadow-2);
  }

  .big .eyebrow,
  .big .line {
    color: var(--color-on-navy-muted);
  }

  .copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  .big .copy,
  .big .n {
    max-width: 52%;
  }

  .title {
    font-size: var(--text-heading);
    font-weight: var(--text-heading--font-weight);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-variation-settings: "wdth" var(--wdth-heading);
    text-wrap: balance;
  }

  .big .title {
    font-size: var(--text-title);
    font-weight: var(--text-title--font-weight);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-stretch: calc(var(--wdth-title) * 1%);
    font-variation-settings: "wdth" var(--wdth-title);
  }

  .line {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    text-wrap: pretty;
  }

  .pn {
    white-space: nowrap;
  }

  .n {
    position: relative;
    z-index: 1;
    font-family: var(--font-num);
    font-size: var(--text-title);
    font-weight: var(--font-weight-num);
    font-variant-numeric: tabular-nums;
    font-variation-settings: "wdth" var(--wdth-num);
    letter-spacing: var(--tracking-num);
    line-height: 1;
  }

  .unit {
    font-size: var(--text-small);
    font-weight: var(--text-body--font-weight);
    font-variation-settings: "wdth" var(--wdth-body);
    letter-spacing: 0;
  }

  .big .unit {
    color: var(--color-on-navy-muted);
  }

  .arrow {
    position: absolute;
    top: var(--space-16);
    right: var(--space-16);
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--space-32);
    height: var(--space-32);
    border-radius: var(--radius-pill);
    background: var(--color-sunken);
    color: var(--color-ink);
  }

  .big .arrow {
    background: var(--color-navy-raised-2);
    color: var(--color-on-navy);
  }

  .shot {
    position: absolute;
    right: var(--space-16);
    bottom: var(--space-16);
    z-index: 0;
    width: 44%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-sunken);
  }

  .shot :global(picture),
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .shot :global(picture) {
    position: absolute;
    inset: 0;
  }

  .shot :global(img) {
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  @media (min-width: 900px) {
    .bento-section {
      padding: var(--space-96) 0;
    }

    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(168px, auto);
    }

    .big {
      grid-column: span 2;
      grid-row: span 2;
      min-height: 0;
    }
  }

  @media (max-width: 899px) {
    .all {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
  }
</style>
