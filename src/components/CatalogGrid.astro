---
/**
 * Catalog grid. docs/pages.md (catalog grid), docs/design-system.md section 4
 * (socket tab) and section 9 (Product card), docs/motion.md interaction 8.
 *
 * The photograph sits in PhotoStage. The card around it is the grid.
 */
import type { ImageMetadata } from "astro";
import AddPart from "./AddPart.tsx";
import PackageFallback from "./illustrations/PackageFallback.astro";
import PartPicture from "./PartPicture.astro";
import PhotoStage from "./PhotoStage.tsx";
import StockIndicator from "./StockIndicator.astro";
import { formatPkr, unitPrice, type PriceBreak } from "../lib/money";
import { rowTransitionName } from "../lib/catalog-query";
import { partChipClass } from "../lib/part-image";

interface GridRow {
  partNumber: string;
  name: string;
  keySpec: string;
  price: number;
  breaks?: readonly PriceBreak[];
  stockQty: number;
  restockOn?: string;
  href: string;
  image?: ImageMetadata;
  packageType: string;
  minQty: number;
  qtyMultiple: number;
  transition?: boolean;
  category?: string;
  order?: number;
  hidden?: boolean;
}

interface Props {
  rows: readonly GridRow[];
}

const { rows } = Astro.props;

const photo = {
  width: 640,
  height: 640,
  sizes: "(min-width: 1200px) 360px, (min-width: 900px) 380px, calc(100vw - 64px)",
  widths: [360, 480, 640, 768],
};
---

<ul class="grid">
  {rows.map((row, index) => {
    const figure = formatPkr(unitPrice({ price: row.price, breaks: row.breaks }, 1)).slice("Rs ".length);
    const vt = rowTransitionName(row.partNumber);
    return (
      <li
        class="grid-tilt"
        data-part={row.partNumber}
        data-category={row.category}
        data-name={row.name}
        data-spec={row.keySpec}
        data-price={row.price}
        data-stock={row.stockQty}
        data-order={row.order}
        data-vt={vt || undefined}
        hidden={row.hidden || undefined}
      >
        <article class="grid-card">
          <a class="card-link" href={row.href} data-astro-prefetch="hover">
            <span class="tab">
              <span class="pin" aria-hidden="true"></span>
              <span class:list={["part", (row.transition ?? true) && partChipClass(row.partNumber)]}>{row.partNumber}</span>
            </span>
            <div class="well">
              {row.image ? (
                <PhotoStage cutout>
                  <PartPicture
                    src={row.image}
                    partNumber={row.partNumber}
                    alt=""
                    width={photo.width}
                    height={photo.height}
                    sizes={photo.sizes}
                    widths={photo.widths}
                    priority={index === 0}
                    transition={row.transition ?? true}
                    fit="contain"
                    class="photo"
                    frameClass="frame"
                  />
                </PhotoStage>
              ) : (
                <PackageFallback packageType={row.packageType} partNumber={row.partNumber}>
                  <span class="fallback">{row.packageType}</span>
                </PackageFallback>
              )}
              <span class="spec-chip">{row.keySpec}</span>
            </div>
            <div class="copy">
              <p class="job">{row.name}</p>
              <div class="meta">
                <StockIndicator stockQty={row.stockQty} restockOn={row.restockOn} />
                <span class="price"><span class="rs">Rs</span>{" "}{figure}</span>
              </div>
            </div>
          </a>
          <div class="quick-add">
            <AddPart
              client:idle
              partNumber={row.partNumber}
              name={row.name}
              minQty={row.minQty}
              qtyMultiple={row.qtyMultiple}
              stockQty={row.stockQty}
            />
          </div>
          <span class="sheen" aria-hidden="true"></span>
        </article>
      </li>
    );
  })}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--column-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .grid-tilt {
    display: flex;
    min-width: 0;
    margin-top: 30px;
  }

  .grid-tilt:has(.is-hot) {
    position: relative;
    z-index: 1;
  }

  .grid-card {
    --product-card: var(--color-surface);
    --rx: 0deg;
    --ry: 0deg;
    --sheen-x: 50%;
    --sheen-y: 30%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    flex: 1;
    width: 100%;
    padding: var(--space-16);
    border-radius: var(--radius-card);
    background: var(--product-card);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  .grid-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }

  .card-link {
    display: grid;
    grid-column: 1;
    grid-row: 1 / span 2;
    grid-template-rows: subgrid;
    grid-template-columns: subgrid;
    gap: var(--space-12);
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .card-link:focus-visible {
    outline: none;
  }

  /* Signature geometry: docs/design-system.md section 4. */
  .tab {
    position: absolute;
    left: var(--space-24);
    bottom: 100%;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    max-width: calc(100% - var(--space-48));
    height: 30px;
    padding: 0 var(--space-12);
    border-radius: 10px 10px 0 0;
    background: var(--product-card);
    color: var(--color-ink);
  }

  .tab::before,
  .tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
  }

  .tab::before {
    right: 100%;
    background: radial-gradient(circle at 0 0, transparent 9.5px, var(--product-card) 10px);
  }

  .tab::after {
    left: 100%;
    background: radial-gradient(circle at 100% 0, transparent 9.5px, var(--product-card) 10px);
  }

  .pin {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--color-action);
  }

  .part {
    overflow: hidden;
    font-family: var(--font-part);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-part);
    font-variation-settings: normal;
    font-variant-numeric: slashed-zero;
    letter-spacing: var(--tracking-part);
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .well {
    position: relative;
    grid-row: 1;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-control);
    background: var(--color-sunken);
  }

  .well :global(picture),
  .well :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .well :global(picture) {
    position: absolute;
    inset: 0;
  }

  .well :global(img) {
    max-width: none;
    object-fit: cover;
    mix-blend-mode: multiply;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-8);
    font-family: var(--font-part);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-part);
    font-variation-settings: normal;
    font-variant-numeric: slashed-zero;
    letter-spacing: var(--tracking-part);
    line-height: var(--text-caption--line-height);
    text-align: center;
    text-wrap: pretty;
  }

  .spec-chip {
    position: absolute;
    z-index: 1;
    top: var(--space-8);
    left: var(--space-8);
    max-width: calc(100% - var(--space-16));
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-chip);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    color: var(--color-ink);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-caption--line-height);
    text-wrap: pretty;
  }

  .copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    grid-row: 2;
    min-width: 0;
  }

  .job {
    margin: 0;
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-small--line-height);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .price {
    flex: none;
    font-family: var(--font-num);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-num);
    font-variant-numeric: tabular-nums;
    font-variation-settings: "wdth" var(--wdth-num);
    letter-spacing: var(--tracking-num);
    line-height: 1;
    white-space: nowrap;
  }

  .rs {
    margin-right: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-caption);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: "wdth" var(--wdth-body);
    letter-spacing: 0;
  }

  .quick-add {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    z-index: 2;
    margin: var(--space-8);
  }

  .quick-add :global(.catalog-add) {
    width: 100%;
  }

  .sheen {
    grid-column: 1;
    grid-row: 1 / span 2;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--sheen-x) var(--sheen-y),
      color-mix(in oklch, var(--color-surface) 6%, transparent),
      transparent
    );
  }

  @media (hover: hover) and (pointer: fine) {
    .grid-tilt {
      perspective: 900px;
    }

    .grid-card {
      transform: rotateX(var(--rx)) rotateY(var(--ry));
      transition: transform var(--dur-3) var(--ease-out), scale var(--dur-1) var(--ease-out);
    }

    .grid-card.is-hot,
    .grid-card.is-settling {
      transition: scale var(--dur-1) var(--ease-out);
    }

    .grid-card.is-hot .well :global(img) {
      transform: scale(1.03);
    }

    .grid-card.is-hot .sheen {
      opacity: 1;
    }

    .grid-card:active {
      scale: 0.97;
    }

    .quick-add {
      opacity: 0;
      pointer-events: none;
      transform: translateY(var(--space-8));
      transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-1) var(--ease-out);
    }

    .grid-card:hover .quick-add,
    .grid-card:focus-within .quick-add {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-card,
    .grid-card.is-hot,
    .grid-card:active,
    .well :global(img),
    .quick-add,
    .grid-card:hover .quick-add,
    .grid-card:focus-within .quick-add {
      transform: none;
      scale: none;
      transition: none;
    }

    .sheen,
    .grid-card.is-hot .sheen {
      opacity: 0;
    }

    .quick-add,
    .grid-card:hover .quick-add,
    .grid-card:focus-within .quick-add {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
