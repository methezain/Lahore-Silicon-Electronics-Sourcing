---
/**
 * Three-step band. docs/design-system.md section 9 (Process band).
 * Delivery and dispatch sentences come from src/lib/shipping.ts.
 * The connector draws with scroll on /home. docs/motion.md item 26.
 */
import { deliveryCost, sameDayDispatch } from "../lib/shipping";
import "./home-reveal.css";

const steps = [
  {
    title: "Add the parts",
    body: "Prices and stock come from the counter. The cart shows the catalog price.",
  },
  {
    title: "Pay the total",
    body: `Transfer the amount shown, then paste the reference. ${deliveryCost}`,
  },
  {
    title: "We pack and dispatch",
    body: sameDayDispatch,
  },
];
---

<section class="band home-reveal" id="ordering" aria-labelledby="ordering-title">
  <div class="band-inner">
    <p class="eyebrow is-long">How ordering works</p>
    <h2 id="ordering-title" class="band-title">Three steps, and you pay the total shown.</h2>
    <div class="steps-wrap">
      <svg class="connector connector-h" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M0 1H100" />
      </svg>
      <svg class="connector connector-v" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M1 0V100" />
      </svg>
      <ol class="steps">
        {steps.map((step, index) => (
          <li class="step">
            <p class="step-k">Step {index + 1}</p>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .band {
    margin: 0 var(--inset);
    border-radius: var(--radius-frame);
    background: var(--color-navy);
    color: var(--color-on-navy);
    padding: var(--space-48) var(--space-20);
  }

  .band-inner {
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: normal;
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-on-navy-muted);
  }

  .eyebrow.is-long {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-strong);
    line-height: var(--text-caption--line-height);
    letter-spacing: 0;
    text-transform: none;
  }

  .band-title {
    max-width: 18ch;
    margin: var(--space-12) 0 0;
    color: var(--color-on-navy);
    font-size: var(--text-display);
    font-weight: var(--text-display--font-weight);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-variation-settings: "wdth" var(--wdth-display);
    font-stretch: calc(var(--wdth-display) * 1%);
    text-wrap: balance;
  }

  .steps-wrap {
    position: relative;
    margin-top: var(--space-40);
  }

  .steps {
    display: grid;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .connector {
    position: absolute;
    z-index: 0;
    color: var(--color-signal);
    pointer-events: none;
  }

  .connector path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .connector-h {
    top: var(--space-32);
    left: calc(100% / 6);
    width: calc(100% * 2 / 3);
    height: var(--space-2);
  }

  .connector-v {
    top: var(--space-24);
    bottom: var(--space-24);
    left: calc(50% - 1px);
    width: var(--space-2);
    height: auto;
  }

  .step {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: var(--space-24);
    border-radius: var(--radius-panel);
    background: var(--color-navy-raised);
    box-shadow: inset 0 0 0 1px var(--color-navy-line);
  }

  .step-k {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    font-variation-settings: normal;
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-signal);
  }

  .step-title {
    margin: var(--space-12) 0 0;
    color: var(--color-on-navy);
    font-size: var(--text-heading);
    font-weight: var(--text-heading--font-weight);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-variation-settings: "wdth" var(--wdth-heading);
    text-wrap: balance;
  }

  .step-body {
    margin: var(--space-8) 0 0;
    color: var(--color-on-navy-muted);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    text-wrap: pretty;
  }

  @media (max-width: 899px) {
    .connector-h {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .band {
      padding: var(--space-80) var(--space-56);
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .connector-v {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .steps-wrap {
        view-timeline-name: --ordering-line;
      }

      .connector path {
        stroke-dashoffset: 1;
        animation: ordering-draw linear both;
        animation-timeline: --ordering-line;
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes ordering-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
