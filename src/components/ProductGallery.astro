---
/**
 * Product gallery. docs/motion.md #12 and #13.
 * Socket tab and 1:1 well: docs/design-system.md sections 4 and 7.
 * Mobile well is 4:5 (premium roadmap R4). Photographs sit in PhotoStage.
 * Only photographs on the part are rendered.
 * The current photo shares a view-transition name with the catalog thumbnail.
 * Thumbs and the viewer do not, because a name can belong to only one element.
 */
import type { ImageMetadata } from "astro";
import { partSlug, productPhoto } from "../lib/part-image";
import PackageFallback from "./illustrations/PackageFallback.astro";
import PartPicture from "./PartPicture.astro";
import PhotoStage from "./PhotoStage.tsx";

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  note?: string;
}

interface Props {
  partNumber: string;
  manufacturer: string;
  packageType: string;
  images?: GalleryImage[];
}

const { partNumber, manufacturer, packageType, images = [] } = Astro.props;
const count = images.length;
const viewerId = `viewer-${partSlug(partNumber) || "part"}`;
const viewerSizes = "(min-width: 900px) calc(100dvh - 128px), 100vw";
const initialNote = images[0]?.note;
---

<div class="gallery-column" data-gallery>
  <div class="gallery">
    <p class="tab">
      <span class="pin" aria-hidden="true"></span>
      <span class="part">{partNumber}</span>
      <span class="maker"> · {manufacturer}</span>
    </p>
    <div class="gallery-well">
      {count > 0 ? (
        <div
          class="gallery-track"
          tabindex={count > 1 ? 0 : undefined}
          aria-label={count > 1 ? `Photographs of ${partNumber}` : undefined}
        >
          {images.map((image, index) => (
            <div
              class:list={["gallery-slide", index === 0 && "is-current"]}
              data-index={index}
              data-note={image.note ?? ""}
            >
              <button
                class="gallery-open"
                type="button"
                aria-haspopup="dialog"
                aria-controls={viewerId}
                aria-label={`Enlarge photograph: ${image.alt}`}
              >
                <PhotoStage cutout>
                  <PartPicture
                    src={image.src}
                    partNumber={partNumber}
                    alt={image.alt}
                    width={productPhoto.width}
                    height={productPhoto.height}
                    sizes={productPhoto.sizes}
                    widths={[...productPhoto.widths]}
                    priority={index === 0}
                    transition={index === 0}
                    fit="contain"
                    frameClass="frame"
                  />
                </PhotoStage>
              </button>
            </div>
          ))}
        </div>
      ) : (
        <PackageFallback packageType={packageType} partNumber={partNumber} stage>
          <p class="fallback">{packageType}</p>
        </PackageFallback>
      )}
      {count > 1 && (
        <div class="gallery-dots">
          {images.map((image, index) => (
            <button
              class="dot"
              type="button"
              data-index={index}
              aria-current={index === 0 ? "true" : undefined}
              aria-label={`Photograph ${index + 1} of ${count}`}
            >
              <span class="sr-only">{image.alt}</span>
            </button>
          ))}
        </div>
      )}
    </div>
    {count > 0 && (
      <div class="thumbs">
        {images.map((image, index) => (
          <button
            class:list={["thumb", index === 0 && "is-current"]}
            type="button"
            data-index={index}
            aria-current={index === 0 ? "true" : undefined}
            aria-label={`Photograph ${index + 1} of ${count}, ${image.alt}`}
          >
            <PhotoStage cutout>
              <PartPicture
                src={image.src}
                partNumber={partNumber}
                alt=""
                width={64}
                height={64}
                sizes="64px"
                widths={[64, 128]}
                transition={false}
                fit="contain"
                frameClass="thumb-frame"
              />
            </PhotoStage>
          </button>
        ))}
      </div>
    )}
  </div>
  {count > 0 && (
    <p class="note" data-gallery-note hidden={!initialNote}>{initialNote}</p>
  )}
  <p class="sr-only" data-gallery-status aria-live="polite"></p>
  {count > 0 && (
    <dialog class="gallery-viewer" id={viewerId} aria-label={`Photographs of ${partNumber}`}>
      <div class="viewer-scrim" aria-hidden="true"></div>
      <button class="viewer-close" type="button" aria-label="Close photograph">
        <svg width="20" height="20" aria-hidden="true" focusable="false"><use href="#close" /></svg>
      </button>
      <div
        class="viewer-track"
        tabindex={count > 1 ? 0 : undefined}
        aria-label={count > 1 ? `Photographs of ${partNumber}` : undefined}
      >
        {images.map((image, index) => (
          <div class="viewer-slide" data-index={index}>
            <div class="viewer-photo">
              <PhotoStage cutout>
                <PartPicture
                  src={image.src}
                  partNumber={partNumber}
                  alt={image.alt}
                  width={productPhoto.width}
                  height={productPhoto.height}
                  sizes={viewerSizes}
                  widths={[...productPhoto.widths]}
                  transition={false}
                  fit="contain"
                  frameClass="frame"
                />
              </PhotoStage>
            </div>
          </div>
        ))}
      </div>
      {count > 1 && (
        <div class="viewer-dots">
          {images.map((_, index) => (
            <button
              class="dot"
              type="button"
              data-index={index}
              aria-current={index === 0 ? "true" : undefined}
              aria-label={`Photograph ${index + 1} of ${count}`}
            />
          ))}
        </div>
      )}
    </dialog>
  )}
</div>

<script>
  import { mountGalleries } from "../lib/gallery";

  mountGalleries();
  document.addEventListener("astro:page-load", mountGalleries);
</script>

<style>
  .gallery-column {
    min-width: 0;
  }

  .gallery {
    --tab-bg: var(--color-surface);
    position: relative;
    margin-top: 34px;
    padding: var(--space-12);
    border-radius: var(--radius-frame);
    background: var(--tab-bg);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  .tab {
    position: absolute;
    left: var(--space-32);
    bottom: 100%;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    max-width: calc(100% - var(--space-48));
    height: 34px;
    margin: 0;
    padding: 0 var(--space-12);
    border-radius: 10px 10px 0 0;
    background: var(--tab-bg);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .tab::before,
  .tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
  }

  .tab::before {
    right: 100%;
    background: radial-gradient(circle at 0 0, transparent 9.5px, var(--tab-bg) 10px);
  }

  .tab::after {
    left: 100%;
    background: radial-gradient(circle at 100% 0, transparent 9.5px, var(--tab-bg) 10px);
  }

  .pin {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: var(--space-2);
    background: var(--color-action);
  }

  .part,
  .maker {
    font-family: var(--font-part);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-part);
    font-variation-settings: normal;
    font-variant-numeric: slashed-zero;
    letter-spacing: var(--tracking-part);
    line-height: 1.2;
  }

  .gallery-well {
    display: grid;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-sunken);
  }

  .gallery-track {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .gallery-track::-webkit-scrollbar,
  .viewer-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .gallery-open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    user-select: none;
  }

  .gallery-open:focus-visible {
    outline: none;
  }

  .gallery-well:has(.gallery-open:focus-visible) {
    box-shadow: inset 0 0 0 2px var(--color-action);
  }

  .gallery-well :global(picture),
  .gallery-well :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery-well :global(picture) {
    position: absolute;
    inset: 0;
  }

  .gallery-well :global(img) {
    max-width: none;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .gallery-dots {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .dot::before {
    content: "";
    width: var(--space-8);
    height: var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-control-line);
  }

  .dot[aria-current="true"]::before {
    background: var(--color-action);
    box-shadow: none;
  }

  .dot:active {
    transform: scale(0.97);
  }

  .fallback {
    display: grid;
    place-items: center;
    height: 100%;
    margin: 0;
    padding: var(--space-16);
    font-family: var(--font-part);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-part);
    font-variation-settings: normal;
    font-variant-numeric: slashed-zero;
    letter-spacing: var(--tracking-part);
    line-height: var(--text-heading--line-height);
    text-align: center;
    text-wrap: pretty;
  }

  .thumbs {
    display: none;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .thumb {
    display: block;
    flex: none;
    width: var(--space-64);
    height: var(--space-64);
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-sunken);
    mix-blend-mode: normal;
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .thumb.is-current {
    box-shadow: inset 0 0 0 2px var(--color-action);
  }

  .thumb:active {
    transform: scale(0.97);
  }

  .thumb :global(picture),
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .thumb :global(img) {
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .gallery-column.is-viewing .gallery-slide :global(img) {
    visibility: hidden;
  }

  .note {
    margin: var(--space-8) 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-caption);
    font-weight: var(--text-caption--font-weight);
    line-height: var(--text-caption--line-height);
    text-wrap: pretty;
  }

  .note[hidden] {
    display: none;
  }

  .gallery-viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: hidden;
  }

  .gallery-viewer::backdrop {
    background: transparent;
  }

  .viewer-scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklch, var(--color-navy) 42%, transparent);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .gallery-viewer.is-open .viewer-scrim {
    opacity: 1;
  }

  .viewer-close {
    position: absolute;
    z-index: 3;
    top: max(var(--space-8), env(safe-area-inset-top, 0px));
    right: max(var(--space-8), env(safe-area-inset-right, 0px));
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-2);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }

  .gallery-viewer.is-open .viewer-close,
  .gallery-viewer.is-open .viewer-dots {
    opacity: 1;
  }

  .viewer-close:hover {
    background: var(--color-sunken);
  }

  .viewer-close:active {
    transform: scale(0.97);
  }

  .viewer-track {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .viewer-slide {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
    padding: var(--space-64) var(--space-16);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .viewer-photo {
    position: relative;
    width: min(100%, calc((100dvh - var(--space-128)) * 4 / 5));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-sunken);
  }

  .viewer-photo.is-covered {
    visibility: hidden;
  }

  .viewer-photo :global(picture),
  .viewer-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .viewer-photo :global(picture) {
    position: absolute;
    inset: 0;
  }

  .viewer-photo :global(img) {
    max-width: none;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .viewer-dots {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: max(var(--space-8), env(safe-area-inset-bottom, 0px));
    display: flex;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .viewer-dots .dot::before {
    background: var(--color-on-navy-muted);
    box-shadow: none;
  }

  .viewer-dots .dot[aria-current="true"]::before {
    background: var(--color-surface);
  }

  :global(.gallery-flyer) {
    position: fixed;
    z-index: 2;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-sunken);
    transform-origin: 0 0;
    pointer-events: none;
  }

  :global(.gallery-flyer.is-moving) {
    will-change: transform;
  }

  :global(.gallery-flyer picture),
  :global(.gallery-flyer img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.gallery-flyer picture) {
    position: absolute;
    inset: 0;
  }

  :global(.gallery-flyer img) {
    max-width: none;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  @media (min-width: 900px) {
    .gallery-well {
      aspect-ratio: 1;
    }

    .gallery-track {
      display: grid;
      overflow: hidden;
      scroll-snap-type: none;
    }

    .gallery-slide {
      grid-area: 1 / 1;
      flex: none;
      width: auto;
      scroll-snap-align: none;
    }

    .gallery-slide:not(.is-current) {
      visibility: hidden;
      pointer-events: none;
    }

    .gallery-dots {
      display: none;
    }

    .thumbs {
      display: flex;
    }

    .viewer-photo {
      width: min(100%, calc(100dvh - var(--space-128)));
      aspect-ratio: 1;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .gallery-open {
      cursor: zoom-in;
    }

    .gallery-slide.is-current :global(img) {
      transform-origin: var(--zoom-x, 50%) var(--zoom-y, 50%);
      transition: transform var(--dur-2) var(--ease-out);
    }

    .gallery-well.is-zooming .gallery-slide.is-current :global(img) {
      transform: scale(2);
      transition: none;
    }

    .gallery-well.is-instant :global(img) {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track,
    .viewer-track {
      scroll-behavior: auto;
    }

    .thumb,
    .dot,
    .viewer-close {
      transition: none;
    }

    .thumb:active,
    .dot:active,
    .viewer-close:active {
      transform: none;
    }

    .viewer-scrim,
    .viewer-close,
    .viewer-dots,
    .viewer-photo {
      transition-duration: var(--dur-1);
    }

    .viewer-photo {
      opacity: 0;
    }

    .gallery-viewer.is-open .viewer-photo {
      opacity: 1;
    }
  }

  .gallery-well :global(.photo-stage),
  .thumb :global(.photo-stage),
  .viewer-photo :global(.photo-stage) {
    width: 100%;
    height: 100%;
  }

  .gallery-well :global(.photo-stage) :global(picture),
  .thumb :global(.photo-stage) :global(picture),
  .viewer-photo :global(.photo-stage) :global(picture) {
    position: relative;
    inset: auto;
  }

  .gallery-well :global(.photo-stage) :global(img),
  .thumb :global(.photo-stage) :global(img),
  .viewer-photo :global(.photo-stage) :global(img),
  :global(.gallery-flyer img) {
    object-fit: contain;
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-transparency: reduce) {
    .viewer-scrim {
      background: var(--color-navy);
    }
  }
</style>
