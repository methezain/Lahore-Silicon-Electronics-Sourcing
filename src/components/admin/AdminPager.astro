---
import { pagerItems } from "../../lib/catalog-query";

interface Props {
  page: number;
  pages: number;
  href: (page: number) => string;
  label?: string;
}

const { page, pages, href, label = "Pages" } = Astro.props;
const items = pagerItems(page, pages);
---

{items.length > 0 && (
  <nav class="admin-pager" aria-label={label}>
    {items.map((item) => {
      if (item.kind === "gap") return <span class="gap" aria-hidden="true">…</span>;
      if (item.kind === "page") {
        return (
          <a href={href(item.page)} aria-label={`Page ${item.page}`} aria-current={item.current ? "page" : undefined}>
            {item.page}
          </a>
        );
      }
      return (
        <a href={href(item.page)} rel={item.kind === "prev" ? "prev" : "next"}>
          {item.kind === "prev" ? "Previous" : "Next"}
        </a>
      );
    })}
  </nav>
)}
