---
/**
 * "You will also need". Hand-picked companions, one tap to add.
 * docs/commerce.md fields to add. docs/pages.md product.
 */
import type { ImageMetadata } from "astro";
import type { PriceBreak } from "../lib/money";
import AddPart from "./AddPart.tsx";
import ProductCard from "./ProductCard.astro";

interface Companion {
  partNumber: string;
  name: string;
  price: number;
  breaks?: readonly PriceBreak[];
  stockQty: number;
  lowStockAt?: number;
  restockOn?: string;
  packageType: string;
  image?: ImageMetadata;
  minQty: number;
  qtyMultiple: number;
}

interface Props {
  parts: Companion[];
}

const { parts } = Astro.props;
---

<ul class="rail">
  {parts.map((part) => (
    <li>
      <ProductCard
        href={`/product/${part.partNumber.toLowerCase()}`}
        partNumber={part.partNumber}
        name={part.name}
        price={part.price}
        breaks={part.breaks}
        stockQty={part.stockQty}
        lowStockAt={part.lowStockAt}
        restockOn={part.restockOn}
        packageType={part.packageType}
        image={part.image}
        layout="row"
        transition={false}
      >
        <AddPart
          slot="add"
          client:load
          partNumber={part.partNumber}
          name={part.name}
          minQty={part.minQty}
          qtyMultiple={part.qtyMultiple}
          stockQty={part.stockQty}
        />
      </ProductCard>
    </li>
  ))}
</ul>

<style>
  .rail {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-4) 0 0;
    list-style: none;
  }

  .rail :global(astro-island) {
    display: block;
  }

  .rail :global(.catalog-add) {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 var(--space-16);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-control-line);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: 1;
    cursor: pointer;
    transition-property: background-color, transform;
    transition-duration: var(--dur-1);
    transition-timing-function: var(--ease-out);
  }

  .rail :global(.catalog-add:hover) {
    background: var(--color-sunken);
  }

  .rail :global(.catalog-add:active) {
    transform: scale(0.97);
  }

  .rail :global(.catalog-add:disabled),
  .rail :global(.catalog-add:disabled:hover),
  .rail :global(.catalog-add:disabled:active) {
    background: var(--color-sunken);
    color: var(--color-ink-muted);
    box-shadow: none;
    transform: none;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail :global(.catalog-add) {
      transition-property: background-color;
    }

    .rail :global(.catalog-add:active) {
      transform: none;
    }
  }
</style>
