---
/**
 * Pill button. docs/design-system.md section 9 (Buttons).
 * One primary (action) per view region. Signal only on navy.
 * Disabled is sunken, and the label says why.
 */
interface Props {
  variant?: "primary" | "signal" | "secondary" | "ghost";
  size?: "default" | "large";
  block?: boolean;
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  id?: string;
  target?: "_blank" | "_self";
  rel?: string;
}

const {
  variant = "primary",
  size = "default",
  block = false,
  href,
  type = "button",
  disabled = false,
  id,
  target,
  rel,
} = Astro.props;

const classes = ["btn", variant, size === "large" && "large", block && "block"];
const relation = target === "_blank" ? rel ?? "noopener noreferrer" : rel;
---

{href && !disabled ? (
  <a class:list={classes} href={href} id={id} target={target} rel={relation}><slot /></a>
) : (
  <button class:list={classes} type={type} disabled={disabled} id={id}><slot /></button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    height: 44px;
    padding: 0 var(--space-20);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: var(--font-weight-strong);
    line-height: 1;
    letter-spacing: var(--text-small--letter-spacing);
    font-variation-settings: "wdth" var(--wdth-body);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition-property: background-color, box-shadow, color, transform;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease-out);
  }

  .btn.large {
    height: auto;
    min-height: 52px;
    padding: var(--space-12) var(--space-16);
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    white-space: normal;
    text-align: center;
  }

  @media (min-width: 900px) {
    .btn.large {
      padding-inline: var(--space-24);
    }
  }

  .btn.block {
    width: 100%;
  }

  .btn.primary {
    background: var(--color-action);
    color: var(--color-surface);
  }

  .btn.primary:hover,
  .btn.primary:active {
    background: var(--color-action-hover);
  }

  .btn.signal {
    background: var(--color-signal);
    color: var(--color-ink);
  }

  .btn.signal:hover,
  .btn.signal:active {
    box-shadow: var(--shadow-1);
  }

  .btn.secondary {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-control-line);
  }

  .btn.secondary:hover,
  .btn.secondary:active {
    background: var(--color-sunken);
  }

  .btn.ghost:hover,
  .btn.ghost:active {
    background: var(--color-sunken);
  }

  .btn:active {
    transform: scale(0.97);
    transition-duration: var(--dur-instant);
  }

  .btn.primary:disabled,
  .btn.signal:disabled,
  .btn.secondary:disabled,
  .btn.ghost:disabled,
  .btn.primary:disabled:hover,
  .btn.signal:disabled:hover,
  .btn.secondary:disabled:hover,
  .btn.ghost:disabled:hover,
  .btn:disabled:active {
    background: var(--color-sunken);
    color: var(--color-ink-muted);
    box-shadow: none;
    transform: none;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition-property: background-color, box-shadow, color;
    }

    .btn:active {
      transform: none;
    }
  }
</style>
