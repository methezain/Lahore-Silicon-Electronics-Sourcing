{
  "ci": {
    "collect": {
      "startServerCommand": "npm run build && node scripts/preview-gzip.mjs",
      "startServerReadyPattern": "compressed preview ready",
      "startServerReadyTimeout": 300000,
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/product/lm7805"
      ],
      "numberOfRuns": 5,
      "settings": {
        "onlyCategories": ["performance"]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": "off",
            "categories:accessibility": "off",
            "categories:best-practices": "off",
            "categories:seo": "off",
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 150, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
            "resource-summary:document:size": ["error", { "maxNumericValue": 30720, "aggregationMethod": "median" }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 35840, "aggregationMethod": "median" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 122880, "aggregationMethod": "median" }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 2, "aggregationMethod": "median" }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "product/lm7805",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 46080, "aggregationMethod": "median" }]
          }
        }
      ]
    }
  }
}
