{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "lahore-silicon-electronics-sourcing",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "electronics-sourcing-db",
			"database_id": "ecde0271-6c9a-4868-8dac-05b88fbc85a8",
			"migrations_dir": "db/migrations"
		}
	],
	"ratelimits": [
		{
			"name": "ORDER_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "ADMIN_LOGIN_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		"TURNSTILE_HOSTNAMES": "lahore-silicon-electronics-sourcing.lahoresilicon-pk.workers.dev"
	}
}